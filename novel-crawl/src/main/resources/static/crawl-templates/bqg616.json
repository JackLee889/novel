{
  "charset": "utf-8",
  "updateBookListUrl": "",
  "bookListUrl": "https://www.bqg616.cc/#/{catId}?page={page}",
  "catIdRule": {
    "catId1": "xuanhuan",
    "catId2": "wuxia",
    "catId3": "dushi",
    "catId4": "lishi",
    "catId5": "kehuan",
    "catId6": "wangyou",
    "catId7": "mm"
  },
  "bookStatusRule": {
    "连载": 0,
    "已经完本": 1
  },
  "bookIdPatten": "href=\"/#/book/(\\d+)/\"",
