# Copy to .env, chmod 600 .env, then enter your own values.
# Leave required secrets blank until configured. Never include .env in releases.
COMPOSE_PROJECT_NAME=novel-plus
APP_IMAGE_PREFIX=novel-plus
APP_IMAGE_TAG=5.3.3-linux
JAVA_BASE_IMAGE=eclipse-temurin:21-jre-jammy
MYSQL_IMAGE=mysql:8.0.46
REDIS_IMAGE=redis:7.4.5-alpine
APP_UID=10001
APP_GID=10001
TZ=Asia/Shanghai

# Internal MySQL: mysql:3306. Existing DB: choose compose.external-db.yaml
# and set a reachable host, credentials and optional explicit TLS JDBC URL.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=novel_plus
MYSQL_USERNAME=novel
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_JDBC_URL=
REDIS_PASSWORD=

# Blank names use <COMPOSE_PROJECT_NAME>_{mysql,redis,pic,books}-data.
# To reuse existing data, explicitly enter the exact existing named volumes.
# Existing schemas need their original application-user credentials; MySQL's
# MYSQL_* initialization variables do not alter an already initialized volume.
MYSQL_VOLUME_NAME=
REDIS_VOLUME_NAME=
PIC_VOLUME_NAME=
BOOKS_VOLUME_NAME=
SEO_VOLUME_NAME=
INIT_EXISTING_DATA_OWNERSHIP=false

# For migration, reuse the existing JWT and cache-manager secret verbatim.
# Do not replace JWT automatically: existing sessions rely on its value.
JWT_SECRET=
JWT_EXPIRATION=604800
CACHE_MANAGER_PASSWORD=
CRAWL_ADMIN_USERNAME=admin
CRAWL_ADMIN_PASSWORD=

WEBSITE_NAME=小说精品屋
WEBSITE_DOMAIN=
TEMPLATE_NAME=green
FRONT_BIND_ADDRESS=127.0.0.1
FRONT_PORT=8083
ADMIN_PORT=8088
CRAWL_PORT=8081
# true for HTTPS reverse proxy. Set false only for intentional direct HTTP QA.
ADMIN_SECURITY_SECURE_COOKIE=true

# Match the EXISTING content layout. Direct JDBC uses book_content; for existing
# book_content0..9 use compose.sharding.yaml and your preserved shard config.
CONTENT_SAVE_STORAGE=db
PIC_SAVE_TYPE=1
PIC_SAVE_STORAGE=local
# Type 1 avoids automatically fetching/updating existing remote covers.
# Type 2 explicitly enables that pre-existing scheduled job.
FEATURES_PAYMENT_ENABLED=false
FEATURES_AI_ENABLED=false
FEATURES_SUBMISSION_ENABLED=false
OPENAI_API_KEY=
READER_ENABLED=true
READER_TTS_ENABLED=true
READER_RESOURCE_HOST_DIR=./reader-resources
JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8'
LOG_LEVEL=INFO

# Apply sql/add-visitor-stats.sql before restarting the updated front.
# Set the actual browser origin; blank falls back to SEO_SITE_URL.
VISITOR_STATS_ENABLED=true
VISITOR_STATS_SITE_URL=
# Optional comma-separated exact origins for aliases, e.g. https://www.example.com
VISITOR_STATS_ALLOWED_ORIGINS=

# Apply repair-seo-*.sql before enabling SEO. Index switches stay disabled in
# the database until the publication scope has been reviewed in the admin UI.
SEO_ENABLED=false
SEO_SITE_URL=
SEO_SITEMAP_WORKER_ENABLED=true
SEO_WORKER_DELAY_MS=1000

# One-time fresh, EMPTY, local schema only. Normal up never runs this profile.
# Review a .sql file in sql/, hash it with sha256sum, then set these explicitly.
# DB_INIT_ACK must be initialize-empty:<MYSQL_DATABASE>. Existing DBs are refused.
DB_INIT_ACK=
DB_INIT_SQL=
DB_INIT_SQL_SHA256=
# Fresh installation only, username admin. Never used to reset an existing DB.
ADMIN_INITIAL_PASSWORD=
